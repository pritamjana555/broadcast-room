// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String @id @default(uuid())
  email      String @unique
  name   String @unique
  password   String
  rooms      Room[] @relation("AdminRooms")
  otherRooms Room[] @relation("RoomMembers")
  chats      Chat[]
}

model Room {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  createdAt DateTime @default(now())
  adminId   String
  shareCode String
  admin     User     @relation("AdminRooms", fields: [adminId], references: [id])
  members   User[]   @relation("RoomMembers")
  chats     Chat[]
}

model Chat {
  id      Int    @id @default(autoincrement())
  roomId  Int
  message String
  userId  String
  room    Room   @relation(fields: [roomId], references: [id])
  admin   User   @relation(fields: [userId], references: [id])
}
